    "@bsv/wallet-toolbox": "^2.15.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
