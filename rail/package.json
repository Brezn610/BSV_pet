{
  "name": "agent-swap-rail",
  "private": true,
  "description": "Non-custodial swap-and-pay rail for AI agents on BSV, with a guardian inside the agent's wallet.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test --test-timeout=300000 test/*.test.ts",
    "spike": "tsx --test --test-timeout=300000 spikes/btms-swap.test.ts",
    "probe:overlay": "tsx spikes/probe-overlay.ts",
    "typecheck": "tsc -p .",
    "desktop:check": "tsx scripts/desktop-check.ts",
    "desktop:maker": "tsx scripts/maker-smoke.ts",
    "diagnose:overlay": "tsx spikes/overlay-diagnose.ts",
    "overlay:check": "tsx scripts/overlay-check.ts",
    "keys:init": "tsx scripts/keys-init.ts",
    "agent:fund": "tsx scripts/agent-fund.ts",
    "agent:fill": "tsx scripts/agent-fill.ts",
    "desktop:offer": "tsx scripts/maker-offer.ts",
    "demo:cdp": "tsx scripts/cdp-demo.ts",
    "price:api3": "tsx scripts/api3-price.ts",
    "cdp": "tsx scripts/cdp-mainnet.ts",
    "analyst": "tsx --use-system-ca scripts/analyst-mainnet.ts",
    "analyst:pay": "tsx --use-system-ca scripts/analyst-pay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bsv/402-pay": "0.3.3",
    "@bsv/btms": "1.2.6",
    "@bsv/overlay": "2.6.4",
    "@bsv/sdk": "3.2.1",
    "@bsv/wallet-toolbox": "2.14.9",
    "better-sqlite3": "^13.0.3",
    "express": "5.3.0",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@bsv/btms-permission-module": "^1.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@bsv/sdk": "3.2.1"
  }
}
